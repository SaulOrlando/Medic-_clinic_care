@startuml
skinparam classAttributeIconSize 0

' --- ENUMS ---
enum RolUsuario {
  MEDICO
  RECEPCIONISTA
  ADMINISTRADOR
  ENCARGADO_INVENTARIO
}

enum EstadoCita {
  PROGRAMADA
  REAGENDADA
  CANCELADA
  ATENDIDA
  NO_ASISTIO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
}

enum EstadoReceta {
  PRESCRITA
  DISPENSADA
}

' --- CLASSES ---
class Usuario {
  - Integer idUsuario
  - String correo
  - String contrasena
  - RolUsuario rol
  - String nombreCompleto
  - String telefono
  + iniciarSesion(): Boolean
}

class Medico {
  - Integer idMedico
  - String especialidad
  - String numeroLicencia
  - Boolean disponible
  + validarLicenciaUnica(): Boolean
  + cambiarDisponibilidad(disponible: Boolean): Void
}

class Paciente {
  - Integer idPaciente
  - String codigoExpediente
  - String nombres
  - String apellidos
  - String documentoIdentidad
  - LocalDate fechaNacimiento
  - String telefono
  - String genero
  + validarDocumentoUnico(): Boolean
}

class Cita {
 - Integer idCita
  - LocalDateTime fechaHora
  - Integer duracionMinutos
  - EstadoCita estado
  + programarCita(): Void
  + reagendarCita(nuevaFechaHora: LocalDateTime, motivo: String): Void
  + cancelarCita(motivo: String): Void
  + estaDisponible(medico: Medico, fechaHora: LocalDateTime, duracion: Integer): Boolean
}

class HistorialCita {
 - Integer idHistorial
  - EstadoCita estadoAnterior
  - EstadoCita estadoNuevo
  - String motivo
  - LocalDateTime fechaCambio
}

class ConsultaMedica {
  - Integer idConsulta
  - LocalDateTime fechaConsulta
  - String motivoConsulta
  - String sintomatologia
  - String diagnostico
  + registrarConsulta(): Void
}

class CategoriaMedicamento {
  - Integer idCategoria
  - String nombre
  - String descripcion
  + crearCategoria(): Void
  + editarCategoria(): Void
  + eliminarCategoria(): Boolean
  + tieneMedicamentosAsociados(): Boolean
}

class Medicamento {
  - Integer idMedicamento
  - String nombreComercial
  - String nombreGenerico
  - String presentacion
  - String unidadMedida
  - String concentracion
  - Integer stockInicial
  - Integer stockDisponible
  - LocalDate fechaVencimiento
  + validarCaducidad(): Boolean
  + actualizarStock(cantidad: Integer): Void
}

class MovimientoInventario {
  - Integer idMovimiento
  - TipoMovimiento tipoMovimiento
  - Integer cantidad
  - LocalDateTime fechaMovimiento
  - String motivo
}

class RecetaDetalle {
  - Integer idRecetaDetalle
  - Integer cantidad
  - String indicaciones
  - EstadoReceta estado
}

' --- RELACIONES ---
Usuario "1" -- "0..1" Medico : vincula/perfil >
Usuario "1" -- "0..*" Cita : gestiona >
Usuario "1" -- "0..*" HistorialCita : registra >
Usuario "1" -- "0..*" MovimientoInventario : registra >
Paciente "1" -- "0..*" Cita : agenda >
Medico "1" -- "0..*" Cita : atiende >
Cita "1" -- "0..1" ConsultaMedica : genera >
Cita "1" -- "0..*" HistorialCita : registra cambios >
ConsultaMedica "1" -- "0..*" RecetaDetalle : prescripcion >
Medicamento "1" -- "0..*" RecetaDetalle : incluye >
Medicamento "1" -- "0..*" MovimientoInventario : afecta >
CategoriaMedicamento "1" -- "0..*" Medicamento : clasifica >
@enduml
